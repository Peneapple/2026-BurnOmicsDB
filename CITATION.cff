message: "If you use BurnOmicsDB, please cite the archived dataset using these metadata."
type: dataset
title: "BurnOmicsDB: a curated and standardized database of human burn injury transcriptomics across tissues, time points, and clinical contexts"
version: "1.0.0"
doi: "10.5281/zenodo.21648675"
date-released: "2026-07-28"
authors:
  - family-names: "Geng"
    given-names: "Peter X."
    affiliation: "Peking University; University of Colorado Boulder"
  - family-names: "Dou"
    given-names: "Zhe"
    affiliation: "Beijing Jishuitan Hospital; Capital Medical University"
contact:
  - family-names: "Geng"
